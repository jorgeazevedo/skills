#!/usr/bin/env bash
# smevals Runner: runs the Copilot CLI on a fresh clone of the task's repo,
# with this skill installed only when EVAL_WITH_SKILL=1.
set -euo pipefail

eval_dir="$(cd "$(dirname "$0")/.." && pwd)"
# VS Code's bundled copilot shadows mise's on PATH, so resolve it explicitly
copilot_bin="$(mise --cd "$eval_dir" where npm:@github/copilot)/node_modules/.bin/copilot"
# The isolated COPILOT_HOME below has no stored login (and containers have no keychain)
export COPILOT_GITHUB_TOKEN="${COPILOT_GITHUB_TOKEN:-$(gh auth token)}"

# Outside this repo so the agent can't stumble on the skill or the eval's .tool-versions
mkdir -p ~/.cache/skill-evals
work="$(mktemp -d ~/.cache/skill-evals/XXXXXX)"
trap 'rm -rf "$work"' EXIT

# Fetch only the pinned commit so no later history or tags are reachable
git init --quiet "$work/repo"
git -C "$work/repo" fetch --quiet --no-tags "$SMEVALS_TASK_REPO" "$SMEVALS_TASK_COMMIT"
git -C "$work/repo" checkout --quiet -B main FETCH_HEAD

# Fresh COPILOT_HOME: no personal skills or instructions leak in
mkdir -p "$work/home"
if [[ "$EVAL_WITH_SKILL" == 1 ]]; then
  mkdir -p "$work/home/skills/validate-github-actions"
  cp "$eval_dir/../../skills/validate-github-actions/SKILL.md" "$work/home/skills/validate-github-actions/"
fi

COPILOT_HOME="$work/home" "$copilot_bin" \
  -C "$work/repo" \
  --model "$SMEVALS_MODEL" \
  --prompt "$SMEVALS_PROMPT" \
  --silent \
  --allow-all \
  --no-ask-user \
  --no-auto-update \
  --secret-env-vars=COPILOT_GITHUB_TOKEN,GH_TOKEN,GITHUB_TOKEN \
  --share "$SMEVALS_RUN_DIR/transcript.md"
